# DTF GangSheet Studio — .gitignore
# WORKFLOW.md §6 무시 목록 + CLOUD.md §3.1 대용량 에셋 보호 병합

# Node
node_modules/

# 빌드 산출물
dist/
build/

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# 임시·로그
tmp/
logs/

# 대용량 테스트 에셋 (GitHub 금지 — 클라우드 드라이브 동기화, CLOUD.md §3)
assets/test-highres/*
!assets/test-highres/.gitkeep
*.psd
*.tiff

# 환경 변수
.env
.env.local

# 로컬 AI 도구 상태 (GitHub 동기화 대상 아님)
.omo/
.codegraph/
